{
  // Cloudflare Workers + Static Assets config for the Orbis frontend.
  // Build (`npm run build`) emits ./dist; wrangler uploads the worker + assets.
  "name": "open-orbis",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  // Production hostnames (Cloudflare zone open-orbis.com). Custom domains
  // create/own their DNS records; www is 301-redirected to the apex in the
  // worker itself.
  "routes": [
    { "pattern": "open-orbis.com", "custom_domain": true },
    { "pattern": "www.open-orbis.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for unmatched client-side routes (SPA), e.g. /myorbis,
    // /oauth/authorize. Backend paths are proxied by the worker before this.
    "not_found_handling": "single-page-application"
  }
}
