# Orbis reverse proxy behind Cloudflare.
#
# api/mcp sit behind the Cloudflare proxy (orange cloud) and terminate TLS
# with a Cloudflare Origin CA certificate (trusted by Cloudflare only, not
# by public clients — do NOT flip these hosts to DNS-only while this config
# is active). The cert/key live on the VPS at /opt/orbis/certs and are
# mounted into the container at /etc/caddy/certs (see docker-compose.prod.yml).

api.open-orbis.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	reverse_proxy backend:8000
}

mcp.open-orbis.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	reverse_proxy mcp:8081
}
