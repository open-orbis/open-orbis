# Orbis production env — copy to /opt/orbis/.env on the VPS and fill every __FILL__.
#   chmod 600 /opt/orbis/.env   (root-only)
#
# Generate secrets:
#   JWT_SECRET:                python -c "import secrets; print(secrets.token_urlsafe(32))"
#   NEO4J_PASSWORD / POSTGRES: openssl rand -base64 24
#   ENCRYPTION_KEY:            DO NOT GENERATE. Copy the EXACT production value:
#                              gcloud secrets versions access latest --secret=encryption-key --project=open-orbis
#
# Note: PORT, CLOUD_RUN_URL and GOOGLE_APPLICATION_CREDENTIALS are set per-service
# in docker-compose.prod.yml and override anything here — no need to change them.

# --- Core ---
ENV=production

# --- Neo4j (in-container) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__FILL__

# --- PostgreSQL (in-container). POSTGRES_PASSWORD must match the password in DATABASE_URL. ---
POSTGRES_PASSWORD=__FILL__
DATABASE_URL=postgresql://orbis:__FILL_SAME_AS_POSTGRES_PASSWORD__@postgres:5432/orbis

# --- Auth / crypto ---
JWT_SECRET=__FILL__
ENCRYPTION_KEY=__FILL_FROM_SECRET_MANAGER__
ENCRYPTION_KEYS_HISTORIC=

# --- LLM / Vertex AI (stays on GCP) ---
LLM_PROVIDER=vertex
GCP_PROJECT_ID=open-orbis
VERTEX_REGION=europe-west1
GEMINI_MODEL=gemini-2.5-pro
LLM_FALLBACK_CHAIN=
# GOOGLE_APPLICATION_CREDENTIALS is set by compose to /app/vertex-key.json

# --- Storage & jobs: leave BOTH empty → local Fernet files + inline asyncio jobs ---
CV_STORAGE_BUCKET=
CLOUD_TASKS_QUEUE=

# --- Frontend / CORS ---
FRONTEND_URL=https://open-orbis.com
CORS_EXTRA_ORIGINS=https://open-orbis.com
# During staging, temporarily append your Pages preview origin, comma-separated, e.g.:
# CORS_EXTRA_ORIGINS=https://open-orbis.com,https://orbis.pages.dev
COOKIE_DOMAIN=

# --- OAuth providers ---
GOOGLE_CLIENT_ID=__FILL__
GOOGLE_CLIENT_SECRET=__FILL__
LINKEDIN_CLIENT_ID=__FILL__
LINKEDIN_CLIENT_SECRET=__FILL__
LINKEDIN_REDIRECT_URI=https://open-orbis.com/auth/linkedin/callback

# --- Email (Resend) ---
RESEND_API_KEY=__FILL__
EMAIL_FROM=OpenOrbis <noreply@open-orbis.com>

# ============================================================================
# Frontend build vars (NOT used by the backend — set these in Cloudflare Pages
# project settings, not in this file):
#   VITE_API_URL=https://api.open-orbis.com
#   VITE_MCP_URL=https://mcp.open-orbis.com/mcp
#   VITE_GOOGLE_CLIENT_ID=<same as GOOGLE_CLIENT_ID>
# ============================================================================
